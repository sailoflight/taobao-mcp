# Public listener. Keep MCP_HOST=127.0.0.1 when an HTTPS reverse proxy runs on
# the same host; use 0.0.0.0 only inside an isolated container/network.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
PORT=8000
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# OAuth 2.1 provider. Access tokens must be JWTs with exp, sub, audience and
# scope/scp claims. Restrict the provider and this allowlist to the one account
# that owns the local Taobao browser profile.
OAUTH_ISSUER_URL=https://auth.example.com
OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
OAUTH_AUDIENCE=https://mcp.example.com/mcp
OAUTH_REQUIRED_SCOPES=taobao:mcp
OAUTH_ALLOWED_SUBJECTS=
OAUTH_JWT_ALGORITHMS=RS256 ES256

# Set only while completing OpenAI domain verification. The route returns this
# value verbatim at /.well-known/openai-apps-challenge.
OPENAI_APPS_CHALLENGE=
